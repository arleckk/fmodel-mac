@@ -57,4 +63,16 @@ internal static MeshLodDto<MeshVertex> FromStaticMesh(StaticMeshDto owner, uint
 
         return new MeshLodDto<MeshVertex>(owner, sourceLodIndex, lod.IndexBuffer.Buffer, vertices, sections, extraUvs, vertexColors, screenSize, lod.CardRepresentationData?.bMostlyTwoSided ?? false);
     }
+
+    private static FVector4 BendDirection(FVector4 direction, FTransform slice, bool inverseScale)
+    {
+        var scale = slice.Scale3D;
+        var v = new FVector(direction.X, direction.Y, direction.Z);
+        v = inverseScale
+            ? v * new FVector(scale.X != 0 ? 1 / scale.X : 0, scale.Y != 0 ? 1 / scale.Y : 0, scale.Z != 0 ? 1 / scale.Z : 0)
+            : v * scale;
+        v = slice.Rotation.RotateVector(v);
+        v.Normalize();
+        return v.ContainsNaN() ? direction : new FVector4(v.X, v.Y, v.Z, direction.W);
+    }
 }
