<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:FModelMac.Controls"
        xmlns:r="using:FModelMac.Rendering"
        x:Class="FModelMac.Views.ModelViewerWindow"
        Title="3D Viewer"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        Background="{StaticResource Layer0BackgroundBrush}">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Layer1BackgroundBrush}" Padding="8,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Frame" ToolTip.Tip="Center the camera on the selection, or on everything (F)" Click="OnFrameClick" />
                    <Button Content="Clear Scene" ToolTip.Tip="Remove every model and map from the viewer" Click="OnClearSceneClick" />
                    <CheckBox x:Name="TexturesToggle" Content="Textures" IsChecked="True" />
                    <CheckBox x:Name="GridToggle" Content="Grid" IsChecked="True" />
                    <CheckBox x:Name="WireframeToggle" Content="Wireframe" />
                    <CheckBox x:Name="BonesToggle" Content="Skeleton" IsEnabled="False" />
                </StackPanel>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Save Screenshot…" Click="OnSaveScreenshotClick" />
            </DockPanel>
        </Border>

        <!-- Animation timeline, shown once an animation is playing on a skeletal mesh -->
        <Border x:Name="TimelineBar" DockPanel.Dock="Bottom" Background="{StaticResource Layer1BackgroundBrush}"
                Padding="8,6" IsVisible="False">
            <Grid ColumnDefinitions="Auto,8,*,10,Auto,12,Auto,8,Auto,8,Auto,8,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <Button x:Name="PlayButton" MinWidth="64" Content="Pause" Click="OnPlayPauseClick" />
                <Slider x:Name="TimeSlider" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" />
                <TextBlock x:Name="TimeText" Grid.Column="4" VerticalAlignment="Center" FontFamily="Menlo" FontSize="11" />
                <ComboBox x:Name="SpeedBox" Grid.Column="6" SelectedIndex="2" VerticalAlignment="Center">
                    <ComboBoxItem Content="0.25×" />
                    <ComboBoxItem Content="0.5×" />
                    <ComboBoxItem Content="1×" />
                    <ComboBoxItem Content="2×" />
                </ComboBox>
                <CheckBox x:Name="LoopToggle" Grid.Column="8" Content="Loop" IsChecked="True" VerticalAlignment="Center" />
                <CheckBox x:Name="RootMotionToggle" Grid.Column="10" Content="Root motion" VerticalAlignment="Center"
                          ToolTip.Tip="Let the animation move the whole model, as in game" />
                <Button Grid.Column="12" Content="Stop" ToolTip.Tip="Back to the reference pose" Click="OnStopAnimationClick" />
                <!-- Blend space parameters (one row per axis) -->
                <TextBlock x:Name="AxisXName" Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0" />
                <Slider x:Name="AxisXSlider" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock x:Name="AxisXValue" Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" FontFamily="Menlo" FontSize="11" Margin="0,6,0,0" />
                <TextBlock x:Name="AxisYName" Grid.Row="2" VerticalAlignment="Center" />
                <Slider x:Name="AxisYSlider" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" />
                <TextBlock x:Name="AxisYValue" Grid.Row="2" Grid.Column="4" VerticalAlignment="Center" FontFamily="Menlo" FontSize="11" />
                <TextBlock x:Name="BlendWeightsText" Grid.Row="1" Grid.RowSpan="2" Grid.Column="6" Grid.ColumnSpan="7" Classes="dim"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock x:Name="AnimationText" Grid.Row="3" Grid.ColumnSpan="13" Classes="dim" FontSize="11" Margin="0,4,0,0" />
            </Grid>
        </Border>

        <!-- Model info and materials, like Snooper's outliner -->
        <Border DockPanel.Dock="Right" Width="300" Background="{StaticResource Layer2BackgroundBrush}" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <c:SectionSeparator Text="SCENE" Margin="0,0,0,4" />
                    <ListBox x:Name="SceneList" Background="Transparent" MaxHeight="190">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="r:SceneItem">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="tabclose" ToolTip.Tip="Remove from the scene"
                                            Click="OnRemoveItemClick" Tag="{Binding}">
                                        <c:Glyph Data="{StaticResource CloseIcon}" />
                                    </Button>
                                    <CheckBox IsChecked="{Binding IsVisible}" ToolTip.Tip="{Binding Details}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <c:SectionSeparator Text="SELECTION" Margin="0,8,0,8" />
                    <Grid Classes="info" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Text="Name" />
                        <TextBlock x:Name="NameText" Grid.Column="1" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                        <TextBlock Grid.Row="1" Text="Type" />
                        <TextBlock x:Name="KindText" Grid.Row="1" Grid.Column="1" />
                        <TextBlock x:Name="LodLabel" Grid.Row="2" Text="LODs" />
                        <TextBlock x:Name="LodText" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Grid.Row="3" Text="Vertices" />
                        <TextBlock x:Name="VerticesText" Grid.Row="3" Grid.Column="1" />
                        <TextBlock Grid.Row="4" Text="Triangles" />
                        <TextBlock x:Name="TrianglesText" Grid.Row="4" Grid.Column="1" />
                        <TextBlock Grid.Row="5" Text="Size" />
                        <TextBlock x:Name="SizeText" Grid.Row="5" Grid.Column="1" />
                    </Grid>
                    <c:SectionSeparator x:Name="MaterialsHeader" Text="MATERIALS" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="RendererText" Classes="dim" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                <Grid x:Name="ListsGrid" RowDefinitions="*,Auto,0">
                <ListBox x:Name="SectionsList" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="r:ViewerSection">
                            <CheckBox IsChecked="{Binding IsVisible}" ToolTip.Tip="{Binding MaterialName}">
                                <StackPanel>
                                    <TextBlock Text="{Binding MaterialName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="MorphsHeader" Grid.Row="1" IsVisible="False">
                    <c:SectionSeparator Text="MORPH TARGETS" />
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Reset" Click="OnResetMorphsClick" />
                        <TextBlock x:Name="MorphsInfo" Classes="dim" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
                <ListBox x:Name="MorphsList" Grid.Row="2" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="r:ViewerMorph">
                            <StackPanel ToolTip.Tip="{Binding Details}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontFamily="Menlo" FontSize="11"
                                               Text="{Binding Weight, StringFormat='{}{0:0.00}'}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Weight}" Margin="0,-6,0,-6" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <Grid>
            <r:ModelViewport x:Name="Viewport"
                             ShowTextures="{Binding #TexturesToggle.IsChecked}"
                             ShowGrid="{Binding #GridToggle.IsChecked}"
                             Wireframe="{Binding #WireframeToggle.IsChecked}"
                             ShowBones="{Binding #BonesToggle.IsChecked}" />
            <TextBlock x:Name="PlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="dim"
                       Text="Double-click meshes in Packages to add them here, a map to explore it, or an animation to play it on the selected mesh" IsHitTestVisible="False" />
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" Classes="dim" FontSize="11"
                       IsHitTestVisible="False"
                       Text="Drag: orbit · Right-drag or Shift-drag: pan · Scroll or pinch: zoom · WASD/QE: move · F: frame" />
        </Grid>
    </DockPanel>
</Window>
