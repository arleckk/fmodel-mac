<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:FModelMac.Controls"
        x:Class="FModelMac.Views.DirectorySelectorWindow"
        Title="Directory Selector"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel>
        <StackPanel Margin="10,5,10,10">
            <TextBlock Text="Instruction" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
            <TextBlock TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Text="We like to make things as simple as possible. Choose the folder holding your game's archives (usually Content/Paks) and its Unreal Engine version. FModel will use this information to find archives to load and decrypt if needed. Make sure to not skip this step!" />
        </StackPanel>

        <Border Background="{StaticResource Layer2BackgroundBrush}" Margin="10,10,10,18" Padding="10">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,10,*,5,Auto" RowDefinitions="Auto,5,Auto" Margin="0,5">
                    <TextBlock Text="UE Versions" VerticalAlignment="Center" />
                    <ComboBox x:Name="Versions" Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Stretch"
                              MaxDropDownHeight="420" />
                    <TextBlock Grid.Row="2" Text="Directory" VerticalAlignment="Center" />
                    <TextBox x:Name="DirectoryBox" Grid.Row="2" Grid.Column="2" Watermark="/path/to/Game/Content/Paks" />
                    <Button Grid.Row="2" Grid.Column="4" Content="..." Click="OnBrowseClick" />
                </Grid>
                <c:SectionSeparator Text="ADD UNDETECTED GAME" Margin="0,8,0,0" />
                <TextBlock HorizontalAlignment="Center" Classes="dim" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Game detection relies on Windows launchers, so on macOS point the directory to a copy of the game's Paks folder." />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource AdonisErrorBrush}" HorizontalAlignment="Center"
                           Margin="0,6,0,0" IsVisible="False" />
            </StackPanel>
        </Border>

        <Border Background="{StaticResource Layer1BackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="30,12,6,12">
                <Button Grid.Column="1" MinWidth="78" Margin="0,0,12,0" Content="OK" IsDefault="True" Click="OnOkClick" />
                <Button Grid.Column="2" MinWidth="78" Margin="0,0,12,0" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
            </Grid>
        </Border>
    </StackPanel>
</Window>
