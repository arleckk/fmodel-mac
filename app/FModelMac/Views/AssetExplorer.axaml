<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FModelMac.ViewModels"
             xmlns:c="using:FModelMac.Controls"
             x:Class="FModelMac.Views.AssetExplorer"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <!-- FModel's TiledFolderButton colors -->
        <LinearGradientBrush x:Key="TiledFolderTabBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#FFE8C480" Offset="0" />
            <GradientStop Color="#FFD9AA63" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TiledFolderBodyBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#FFF3D9A4" Offset="0" />
            <GradientStop Color="#FFE5BD77" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TiledFolderOutlineBrush" Color="#D8A360" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The rows are only a virtualizing container: no selection look of their own -->
        <Style Selector="ListBox.explorer ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="ListBox.explorer ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.explorer ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Tiles and list rows: FModel's explorer item container -->
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{StaticResource Layer0BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.tile:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Layer1HighlightBorderBrush}" />
        </Style>
        <Style Selector="Border.tile.selected">
            <Setter Property="BorderBrush" Value="{StaticResource AdonisAccentBrush}" />
            <Setter Property="Background" Value="#1D3A66" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{StaticResource Layer2HighlightBrush}" />
        </Style>
        <Style Selector="Border.row.selected">
            <Setter Property="Background" Value="#1D3A66" />
        </Style>
        <Style Selector="ToggleButton.view">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource Layer3BackgroundBrush}" BorderBrush="{StaticResource Layer3BorderBrush}"
            BorderThickness="1" Padding="10,10,4,4">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Search, category, grid / list -->
            <Grid ColumnDefinitions="*,5,Auto,5,Auto" Margin="0,0,6,0">
                <c:SearchTextBox x:Name="SearchBox" Text="{Binding Explorer.SearchText}" Watermark="Search in this folder" />
                <ComboBox x:Name="CategoryBox" Grid.Column="2" MinWidth="150" VerticalAlignment="Stretch"
                          ItemsSource="{Binding Explorer.Categories}" SelectedItem="{Binding Explorer.SelectedCategory}"
                          ToolTip.Tip="Category (⌥0–⌥9)" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                    <ToggleButton Classes="view" ToolTip.Tip="Grid View" IsChecked="{Binding Explorer.IsGrid}">
                        <c:Glyph Data="{StaticResource GridIcon}" Width="14" Height="14" />
                    </ToggleButton>
                    <ToggleButton Classes="view" ToolTip.Tip="List View" IsChecked="{Binding Explorer.IsList}">
                        <c:Glyph Data="{StaticResource ListIcon}" Width="14" Height="14" />
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <c:Breadcrumb x:Name="ExplorerBreadcrumb" Grid.Row="1" Margin="0,5,0,5" HorizontalAlignment="Left"
                          Path="{Binding Explorer.Folder.FullPath, FallbackValue=''}" />

            <ListBox x:Name="RowsList" Grid.Row="2" Classes="explorer" Background="Transparent"
                     ItemsSource="{Binding Explorer.Rows}" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExplorerRow">
                        <Panel>
                            <!-- Grid: a line of tiles -->
                            <ItemsControl ItemsSource="{Binding Entries}" IsVisible="{Binding IsGrid}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="vm:ExplorerFile">
                                        <Border Classes="tile" Classes.selected="{Binding IsSelected}" Width="141" Height="205" Margin="4"
                                                Padding="5" PointerPressed="OnEntryPressed" DoubleTapped="OnEntryDoubleTapped"
                                                ToolTip.Tip="{Binding File.Path}">
                                            <Grid RowDefinitions="128,2,*">
                                                <Panel Background="{StaticResource Layer3BorderBrush}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                    <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Width="64" Height="64"
                                                          Stretch="Uniform" IsVisible="{Binding ShowIcon}" />
                                                    <!-- Texture arrays: how many layers -->
                                                    <Border IsVisible="{Binding HasLayers}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="4" Padding="6,2" CornerRadius="3" Opacity="0.85"
                                                            Background="{StaticResource Layer3BackgroundBrush}">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <TextBlock Text="{Binding Layers}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                            <c:Glyph Data="{StaticResource TextureIcon}" Width="12" Height="12" Foreground="White" />
                                                        </StackPanel>
                                                    </Border>
                                                </Panel>
                                                <Rectangle Grid.Row="1" Fill="{Binding IconBrush}" />
                                                <Grid Grid.Row="2" Margin="0,5,0,0" RowDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                    <Grid Grid.Row="1" ColumnDefinitions="*,5,Auto">
                                                        <TextBlock Text="{Binding TypeName}" FontSize="9" Classes="dim" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="9" Classes="dim" />
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:ExplorerFolder">
                                        <Border Classes="tile" Classes.selected="{Binding IsSelected}" Width="141" Height="205" Margin="4"
                                                Padding="5" PointerPressed="OnEntryPressed" DoubleTapped="OnEntryDoubleTapped"
                                                ToolTip.Tip="{Binding Node.FullPath}">
                                            <Grid RowDefinitions="Auto,*" VerticalAlignment="Center">
                                                <Viewbox Height="96">
                                                    <Canvas Width="128" Height="128">
                                                        <Path Fill="{StaticResource TiledFolderTabBrush}" Stroke="{StaticResource TiledFolderOutlineBrush}"
                                                              StrokeThickness="2" Data="M20 34 H54 L62 46 H108 C112 46 115 49 115 53 V60 H13 V45 C13 39 16 34 20 34 Z" />
                                                        <Path Fill="{StaticResource TiledFolderBodyBrush}" Stroke="{StaticResource TiledFolderOutlineBrush}"
                                                              StrokeThickness="2" Data="M13 60 H115 V104 C115 110 110 115 104 115 H24 C18 115 13 110 13 104 Z" />
                                                        <Ellipse Canvas.Left="90" Canvas.Top="90" Width="36" Height="36" Opacity="0.95"
                                                                 Stroke="#b28c53" StrokeThickness="1.5" Fill="{StaticResource Layer3BackgroundBrush}"
                                                                 IsVisible="{Binding HasBadge}" />
                                                        <Path Canvas.Left="98" Canvas.Top="98" Width="20" Height="20" Stretch="Uniform"
                                                              Data="{Binding Badge}" Fill="{Binding BadgeBrush}" IsVisible="{Binding HasBadge}" />
                                                    </Canvas>
                                                </Viewbox>
                                                <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,5" />
                                                    <TextBlock Text="{Binding SubfoldersText}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding AssetsText}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>

                            <!-- List: one row, name / type / size -->
                            <ContentControl Content="{Binding First}" IsVisible="{Binding IsList}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate DataType="vm:ExplorerFile">
                                        <Border Classes="row" Classes.selected="{Binding IsSelected}"
                                                PointerPressed="OnEntryPressed" DoubleTapped="OnEntryDoubleTapped" ToolTip.Tip="{Binding File.Path}">
                                            <Grid ColumnDefinitions="3*,1*,1.2*">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Panel Width="20" Height="20" Margin="0,0,8,0">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                                                        <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Stretch="Uniform" IsVisible="{Binding ShowIcon}" />
                                                    </Panel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontSize="12" Classes="dim"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Classes="dim"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:ExplorerFolder">
                                        <Border Classes="row" Classes.selected="{Binding IsSelected}"
                                                PointerPressed="OnEntryPressed" DoubleTapped="OnEntryDoubleTapped" ToolTip.Tip="{Binding Node.FullPath}">
                                            <Grid ColumnDefinitions="3*,1*,1.2*">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                                        <Canvas Width="128" Height="128">
                                                            <Path Fill="{StaticResource TiledFolderTabBrush}" Stroke="{StaticResource TiledFolderOutlineBrush}"
                                                                  StrokeThickness="4" Data="M20 34 H54 L62 46 H108 C112 46 115 49 115 53 V60 H13 V45 C13 39 16 34 20 34 Z" />
                                                            <Path Fill="{StaticResource TiledFolderBodyBrush}" Stroke="{StaticResource TiledFolderOutlineBrush}"
                                                                  StrokeThickness="4" Data="M13 60 H115 V104 C115 110 110 115 104 115 H24 C18 115 13 110 13 104 Z" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="Folder" FontSize="12" Classes="dim" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding AssetsText}" FontSize="12" Classes="dim"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       IsVisible="{Binding !Explorer.HasFolder}"
                       Text="Pick a folder in the Folders tab to browse it here.&#10;Double-click a file to open it; ⌘[ brings the explorer back." />
            <TextBlock Grid.Row="2" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding Explorer.IsEmpty}" Text="Nothing matches the filter" />

            <TextBlock Grid.Row="3" Classes="dim" FontSize="11" Margin="0,4,0,0" Text="{Binding Explorer.Status}" />
        </Grid>
    </Border>
</UserControl>
