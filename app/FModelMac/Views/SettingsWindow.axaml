<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:FModelMac.Controls"
        xmlns:v="using:FModelMac.Views"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="FModelMac.Views.SettingsWindow"
        Title="Settings"
        Width="760" Height="620" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Layer1BackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,12,6,12">
                <TextBlock Classes="dim" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="* Changes the way the game is read: it is mounted again when you press OK" />
                <Button Grid.Column="1" MinWidth="78" Margin="12,0,12,0" Content="OK" IsDefault="True" Click="OnOkClick" />
                <Button Grid.Column="2" MinWidth="78" Margin="0,0,12,0" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Classes="fill" Margin="10,10,10,10">
            <!-- GENERAL: output, how the game is read, packages language -->
            <TabItem Header="General">
                <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10">
                    <StackPanel>
                        <c:SectionSeparator Text="OUTPUT" Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="150,10,*,5,Auto">
                            <TextBlock Text="Output Directory" VerticalAlignment="Center" />
                            <TextBox x:Name="OutputBox" Grid.Column="2" />
                            <Button Grid.Column="4" Content="..." Click="OnBrowseOutputClick" />
                        </Grid>
                        <CheckBox x:Name="KeepStructureBox" Margin="160,6,0,0" Content="Keep Directory Structure" />
                        <TextBlock Classes="dim" FontSize="11" Margin="160,4,0,0" TextWrapping="Wrap"
                                   Text="Exports go under Output/Exports. Properties, decompiled blueprints and audio mirror the package path, or all land in Exports with this off. The Export Session always keeps the structure." />

                        <c:SectionSeparator Text="GAME" />
                        <Grid ColumnDefinitions="150,10,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                            <TextBlock Text="UE Version *" VerticalAlignment="Center" />
                            <ComboBox x:Name="UeVersionBox" Grid.Column="2" HorizontalAlignment="Stretch" MaxDropDownHeight="420" />
                            <TextBlock Grid.Row="2" Text="Texture Platform *" VerticalAlignment="Center" />
                            <ComboBox x:Name="PlatformBox" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="4" Text="Versioning *" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button Content="Custom Versions…" Click="OnCustomVersionsClick" />
                                <Button Content="Options…" Click="OnOptionsClick" />
                                <Button Content="MapStructTypes…" Click="OnMapStructTypesClick" />
                            </StackPanel>
                            <TextBlock x:Name="VersioningText" Grid.Row="6" Grid.Column="2" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Classes="dim" FontSize="11" Margin="160,4,0,0" TextWrapping="Wrap"
                                   Text="Saved for this game directory. The texture platform matters for console cooks; the versioning overrides are for games with engine changes CUE4Parse can't detect." />

                        <c:SectionSeparator Text="LANGUAGE" />
                        <Grid ColumnDefinitions="150,10,*">
                            <TextBlock Text="Packages Language" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="2" HorizontalAlignment="Stretch" MaxDropDownHeight="420" />
                        </Grid>
                        <TextBlock Classes="dim" FontSize="11" Margin="160,4,0,0" TextWrapping="Wrap"
                                   Text="The language localized texts (FText) are shown in. If the game doesn't ship that exact culture, the closest one is used." />

                        <c:SectionSeparator Text="ADVANCED" />
                        <CheckBox x:Name="ScriptDataBox" Margin="160,0,0,0" Content="Serialize script bytecode" />
                        <CheckBox x:Name="ShaderMapsBox" Margin="160,4,0,0" Content="Serialize inlined shader maps" />
                        <TextBlock Classes="dim" FontSize="11" Margin="160,4,0,0" TextWrapping="Wrap"
                                   Text="Adds Blueprint function bytecode and material shader maps to the properties JSON. Slower and much longer; Decompile Blueprint reads the bytecode either way." />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- EXPORT: FModel's export options, passed to CUE4Parse's ExportSession -->
            <TabItem Header="Export">
                <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10,10,4,10">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <c:SectionSeparator Text="EXPORT" Margin="0,0,0,8" />
                            <CheckBox x:Name="ExportImmediatelyBox" Margin="180,0,0,0" Content="Export immediately" />
                            <TextBlock Classes="dim" FontSize="11" Margin="180,4,0,0" TextWrapping="Wrap"
                                       Text="Off, like FModel: Export › Model, Animation, World and Texture queue the assets in Views › Export Session, where you export them all at once. On: they're exported right away." />
                            <v:ExportOptionsPanel x:Name="ExportOptions" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- PREVIEW: what extracting a package opens in the 3D viewer -->
            <TabItem Header="Preview">
                <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10">
                    <StackPanel>
                        <c:SectionSeparator Text="3D VIEWER" Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="150,10,*,10,50" Margin="0,0,0,8">
                            <TextBlock Text="Preview Max Texture Size" VerticalAlignment="Center" />
                            <Slider x:Name="PreviewTextureSizeSlider" Grid.Column="2" Minimum="4" Maximum="4096" IsSnapToTickEnabled="True"
                                    Ticks="4,8,16,32,64,128,256,512,1024,2048,4096" TickPlacement="None" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Text="{Binding #PreviewTextureSizeSlider.Value, StringFormat='{}{0:0} px'}" />
                        </Grid>
                        <CheckBox x:Name="PreviewStaticBox" Margin="160,0,0,0" Content="Preview Static Meshes" />
                        <CheckBox x:Name="PreviewSkeletalBox" Margin="160,4,0,0" Content="Preview Skeletal Meshes" />
                        <CheckBox x:Name="PreviewAnimationsBox" Margin="160,4,0,0" Content="Preview Animations" />
                        <CheckBox x:Name="PreviewMaterialsBox" Margin="160,4,0,0" Content="Preview Materials" />
                        <CheckBox x:Name="PreviewWorldsBox" Margin="160,4,0,0" Content="Preview Worlds (.umap)" />
                        <TextBlock Classes="dim" FontSize="11" Margin="160,4,0,0" TextWrapping="Wrap"
                                   Text="Double-clicking a package of that kind also opens it in Views › 3D Viewer. Animations play on the mesh selected in the viewer; materials show on a cube, or replace the material of the section whose overwrite button is on. Maps keep their textures at 512 px at most." />

                        <c:SectionSeparator Text="SKELETONS" />
                        <CheckBox x:Name="SkeletonAsMeshBox" Margin="160,0,0,0" Content="Handle Skeletons as Empty Meshes" />
                        <TextBlock Classes="dim" FontSize="11" Margin="160,4,0,0" TextWrapping="Wrap"
                                   Text="Skeletons open in the 3D viewer as bones only (animations can play on them), and Export › Model takes them too. glTF can't hold a lone skeleton, so they're exported as USD." />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- HOTKEYS: FModel's keybindings, ⌘ instead of Ctrl -->
            <TabItem Header="Hotkeys">
                <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10,10,4,10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,6,0">
                            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Click a box and press the keys. Delete, Backspace or Esc clears it. Single keys don't fire while you type in a text field." />
                            <Button Grid.Column="1" Margin="10,0,0,0" Content="Reset to Defaults" Click="OnResetHotkeysClick" />
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <StackPanel x:Name="HotkeysPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- LUA: FModel's Settings › Unluac -->
            <TabItem Header="Lua">
                <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <c:SectionSeparator Text="UNLUAC" Margin="0,0,0,8" />
                            <CheckBox x:Name="DecompileLuaBox" Margin="160,0,0,0" Content="Decompile Lua" />
                            <Grid ColumnDefinitions="150,10,*" Margin="0,8,0,0">
                                <TextBlock Text="Mode" VerticalAlignment="Center" />
                                <ComboBox x:Name="LuaModeBox" Grid.Column="2" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Decompile (Lua source)" />
                                    <ComboBoxItem Content="Disassemble (unluac assembly)" />
                                </ComboBox>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="18" Margin="160,8,0,0">
                                <CheckBox x:Name="LuaRawStringBox" Content="Raw string" ToolTip.Tip="Keep strings' bytes as they are instead of escaping them" />
                                <CheckBox x:Name="LuaNoDebugBox" Content="No debug" ToolTip.Tip="Ignore the debug information (local names) of the chunk" />
                                <CheckBox x:Name="LuaLuajBox" Content="LuaJ" ToolTip.Tip="Chunks compiled by LuaJ" />
                            </StackPanel>
                            <TextBlock x:Name="LuaStatusText" Classes="dim" FontSize="11" Margin="160,6,0,0" TextWrapping="Wrap" />
                            <c:SectionSeparator Text="OPCODE MAP (THIS GAME)" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Classes="dim" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="For games that shuffle Lua's opcodes: unluac's .op format, one '.op &lt;number&gt; &lt;name&gt;' per line. Saved for the current game directory, like FModel. Leave empty for standard Lua." />
                        <TextBox x:Name="LuaOpCodeMapBox" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Menlo, monospace" FontSize="12"
                                 VerticalContentAlignment="Top" Watermark=".op 0 move&#x0a;.op 1 loadk&#x0a;…" />
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="Audio">
                <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10">
                    <StackPanel>
                        <c:SectionSeparator Text="AUDIO" Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="150,10,*">
                            <TextBlock Text="Audio Export Format" VerticalAlignment="Center" />
                            <ComboBox x:Name="AudioFormatBox" Grid.Column="2" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Convert to .wav" />
                                <ComboBoxItem Content="Keep the original format (.wem, .ogg, .binka…)" />
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="PlayAudioBox" Margin="160,6,0,0" Content="Play sounds in the Audio Player when extracting them" />
                        <Grid ColumnDefinitions="150,10,*" Margin="0,8,0,0">
                            <TextBlock Text="CRIWARE Key" VerticalAlignment="Center" />
                            <TextBox x:Name="CriwareBox" Grid.Column="2" Watermark="Optional HCA/ADX decryption key (decimal or 0x…)" />
                        </Grid>
                        <Grid ColumnDefinitions="150,10,*,5,Auto" Margin="0,8,0,0">
                            <TextBlock Text="vgmstream" VerticalAlignment="Center" />
                            <TextBlock x:Name="VgmstreamText" Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="VgmstreamButton" Grid.Column="4" Content="Copy Install Command" Click="OnCopyVgmstreamClick" />
                        </Grid>
                        <TextBlock Classes="dim" FontSize="11" Margin="160,4,0,0" TextWrapping="Wrap"
                                   Text="Wwise (.wem), Bink, Opus, AT9 and other game codecs are decoded with vgmstream, included with the app (a Homebrew install is used if it's missing). Ogg, WAV and CRIWARE are decoded by the app itself." />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Endpoints">
                <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10">
                    <StackPanel>
                        <c:SectionSeparator Text="ENDPOINTS" Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="150,10,*,5,Auto" RowDefinitions="Auto,6,Auto">
                            <TextBlock Text="AES Endpoint *" VerticalAlignment="Center" />
                            <TextBlock x:Name="AesEndpointText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="4" Content="Configure…" Click="OnAesEndpointClick" />
                            <TextBlock Grid.Row="2" Text="Mapping Endpoint *" VerticalAlignment="Center" />
                            <TextBlock x:Name="MappingEndpointText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="2" Grid.Column="4" Content="Configure…" Click="OnMappingEndpointClick" />
                        </Grid>
                        <Grid ColumnDefinitions="150,10,*" Margin="0,8,0,0">
                            <TextBlock Text="AES Reload at Launch" VerticalAlignment="Center" />
                            <ComboBox x:Name="AesReloadBox" Grid.Column="2" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Classes="dim" FontSize="11" Margin="160,4,0,0" TextWrapping="Wrap"
                                   Text="When the game is mounted, the AES endpoint replaces the saved keys (always, never or once per day); the mapping is downloaded once and cached. Presets for Fortnite and VALORANT, like FModel." />

                        <c:SectionSeparator Text="MAPPINGS" />
                        <Grid ColumnDefinitions="150,10,*,5,Auto,5,Auto">
                            <TextBlock Text="Mapping File *" VerticalAlignment="Center" />
                            <TextBox x:Name="UsmapBox" Grid.Column="2" Watermark="Optional local .usmap / .jmap (wins over the endpoint)" />
                            <Button Grid.Column="4" Content="..." Click="OnBrowseUsmapClick" />
                            <Button Grid.Column="6" Classes="toolbar" ToolTip.Tip="Clear" Click="OnClearUsmapClick">
                                <c:Glyph Data="{StaticResource RemoveIcon}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>
            <!-- THEMES: FModel's JSON highlight themes, with its preview -->
            <TabItem Header="Themes">
                <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="150,10,*" Margin="0,0,0,8">
                            <TextBlock Text="JSON Highlight Theme" VerticalAlignment="Center" />
                            <ComboBox x:Name="JsonThemeBox" Grid.Column="2" HorizontalAlignment="Stretch" MaxDropDownHeight="420"
                                      SelectionChanged="OnJsonThemeChanged" />
                        </Grid>
                        <Border Background="{StaticResource Layer1BackgroundBrush}" Padding="1">
                            <ae:TextEditor x:Name="JsonPreview" IsReadOnly="True" ShowLineNumbers="True"
                                           FontFamily="Menlo, Consolas, monospace" FontSize="12" Padding="8"
                                           Foreground="{StaticResource EditorForegroundBrush}" LineNumbersForeground="#6E7381"
                                           Background="{StaticResource Layer3BackgroundBrush}"
                                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
