<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:FModel.Controls">
    <!--
        AdonisUI "Dark" color scheme as used by FModel (App.xaml overrides Accent/Alert/Error),
        layered on top of Avalonia's Fluent theme so controls look like the original WPF app.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <Color x:Key="Layer0BackgroundColor">#2A2B34</Color>
            <Color x:Key="Layer1BackgroundColor">#3D3D4C</Color>
            <Color x:Key="Layer1BorderColor">#4A4A5E</Color>
            <Color x:Key="Layer1HighlightColor">#4C4F62</Color>
            <Color x:Key="Layer1HighlightBorderColor">#727290</Color>
            <Color x:Key="Layer1IntenseHighlightColor">#5C5F74</Color>
            <Color x:Key="Layer2BackgroundColor">#32323F</Color>
            <Color x:Key="Layer2BorderColor">#272730</Color>
            <Color x:Key="Layer2HighlightColor">#3D3D4C</Color>
            <Color x:Key="Layer3BackgroundColor">#262630</Color>
            <Color x:Key="Layer3BorderColor">#1F2029</Color>
            <Color x:Key="Layer3HighlightColor">#3B3D4A</Color>
            <Color x:Key="Layer4BackgroundColor">#323341</Color>
            <Color x:Key="Layer4BorderColor">#414255</Color>
            <Color x:Key="AdonisForegroundColor">#F0F0F0</Color>
            <Color x:Key="AdonisDisabledForegroundColor">#8E8E8E</Color>
            <Color x:Key="AdonisAccentColor">#206BD4</Color>
            <Color x:Key="AdonisAccentHighlightColor">#5168B7</Color>
            <Color x:Key="AdonisAlertColor">#D49220</Color>
            <Color x:Key="AdonisErrorColor">#C22B2B</Color>

            <SolidColorBrush x:Key="Layer0BackgroundBrush" Color="{StaticResource Layer0BackgroundColor}" />
            <SolidColorBrush x:Key="Layer1BackgroundBrush" Color="{StaticResource Layer1BackgroundColor}" />
            <SolidColorBrush x:Key="Layer1BorderBrush" Color="{StaticResource Layer1BorderColor}" />
            <SolidColorBrush x:Key="Layer1HighlightBrush" Color="{StaticResource Layer1HighlightColor}" />
            <SolidColorBrush x:Key="Layer1HighlightBorderBrush" Color="{StaticResource Layer1HighlightBorderColor}" />
            <SolidColorBrush x:Key="Layer1IntenseHighlightBrush" Color="{StaticResource Layer1IntenseHighlightColor}" />
            <SolidColorBrush x:Key="Layer2BackgroundBrush" Color="{StaticResource Layer2BackgroundColor}" />
            <SolidColorBrush x:Key="Layer2BorderBrush" Color="{StaticResource Layer2BorderColor}" />
            <SolidColorBrush x:Key="Layer2HighlightBrush" Color="{StaticResource Layer2HighlightColor}" />
            <SolidColorBrush x:Key="Layer3BackgroundBrush" Color="{StaticResource Layer3BackgroundColor}" />
            <SolidColorBrush x:Key="Layer3BorderBrush" Color="{StaticResource Layer3BorderColor}" />
            <SolidColorBrush x:Key="Layer3HighlightBrush" Color="{StaticResource Layer3HighlightColor}" />
            <SolidColorBrush x:Key="Layer4BackgroundBrush" Color="{StaticResource Layer4BackgroundColor}" />
            <SolidColorBrush x:Key="Layer4BorderBrush" Color="{StaticResource Layer4BorderColor}" />
            <SolidColorBrush x:Key="AdonisForegroundBrush" Color="{StaticResource AdonisForegroundColor}" />
            <SolidColorBrush x:Key="AdonisDisabledForegroundBrush" Color="{StaticResource AdonisDisabledForegroundColor}" />
            <SolidColorBrush x:Key="AdonisAccentBrush" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="AdonisAccentHighlightBrush" Color="{StaticResource AdonisAccentHighlightColor}" />
            <SolidColorBrush x:Key="AdonisAlertBrush" Color="{StaticResource AdonisAlertColor}" />
            <SolidColorBrush x:Key="AdonisErrorBrush" Color="{StaticResource AdonisErrorColor}" />
            <SolidColorBrush x:Key="EditorForegroundBrush" Color="#DAE5F2" />
            <SolidColorBrush x:Key="TreeBadgeBrush" Color="#705542" />

            <!-- Fluent overrides: compact WPF-like metrics, square corners, Adonis colors -->
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
            <!-- Fluent defaults to Inter; use the platform default (Helvetica Neue, see Program.cs), close to FModel's Segoe UI -->
            <FontFamily x:Key="ContentControlThemeFontFamily">$Default</FontFamily>
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <Color x:Key="SystemAccentColor">#206BD4</Color>
            <Color x:Key="SystemAccentColorLight1">#3A82E6</Color>
            <Color x:Key="SystemAccentColorDark1">#1A5BB5</Color>

            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource Layer1BackgroundColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource Layer1HighlightColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource Layer1BackgroundColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource Layer1BorderColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource Layer1HighlightBorderColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource AdonisForegroundColor}" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource AdonisForegroundColor}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource AdonisForegroundColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource AdonisDisabledForegroundColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource AdonisDisabledForegroundColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource AdonisDisabledForegroundColor}" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource AdonisAccentColor}" />
            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <Thickness x:Key="TextControlThemePadding">6,3,6,3</Thickness>

            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource Layer1BackgroundColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Layer1HighlightColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Layer1IntenseHighlightColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource Layer2BackgroundColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource Layer1BorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Layer1HighlightBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Layer1HighlightBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource Layer1BorderColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource AdonisForegroundColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource AdonisForegroundColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource AdonisForegroundColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource AdonisDisabledForegroundColor}" />
            <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>

            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource Layer1HighlightColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{StaticResource Layer1IntenseHighlightColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource AdonisAccentHighlightColor}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource Layer1BackgroundColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource Layer1HighlightColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource Layer1IntenseHighlightColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource Layer2BackgroundColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource Layer1BorderColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource Layer1HighlightBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource AdonisDisabledForegroundColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Layer2BackgroundColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource Layer1BorderColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource Layer1HighlightColor}" />
            <Thickness x:Key="ComboBoxPadding">8,2,0,2</Thickness>

            <!-- ListBox selection: Adonis uses the accent color for selected items -->
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{StaticResource Layer3HighlightColor}" />
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{StaticResource Layer1HighlightColor}" />

            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource Layer2BackgroundColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource Layer1BorderColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{StaticResource AdonisDisabledForegroundColor}" />
            <Thickness x:Key="MenuFlyoutPresenterThemePadding">0,2</Thickness>
            <Thickness x:Key="MenuFlyoutItemThemePadding">8,4,8,4</Thickness>

            <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource Layer2BackgroundColor}" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource Layer1BorderColor}" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource AdonisForegroundColor}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AdonisAccentColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource Layer1HighlightBorderColor}" />

            <SolidColorBrush x:Key="GridSplitterBackground" Color="{StaticResource Layer0BackgroundColor}" />

            <!-- FModel's folder icon (Resources.xaml TreeFolderClosedImage / TreeFolderOpenImage) -->
            <LinearGradientBrush x:Key="FolderTabGradient" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFE8C480" Offset="0" />
                <GradientStop Color="#FFD9AA63" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="FolderBodyGradient" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFF3D9A4" Offset="0" />
                <GradientStop Color="#FFE5BD77" Offset="1" />
            </LinearGradientBrush>
            <DrawingImage x:Key="TreeFolderClosedImage">
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource FolderTabGradient}"
                                     Geometry="M20 34 H54 L62 46 H108 C112 46 115 49 115 53 V60 H13 V45 C13 39 16 34 20 34 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#AC783F" Thickness="5" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource FolderBodyGradient}"
                                     Geometry="M13 60 H115 V104 C115 110 110 115 104 115 H24 C18 115 13 110 13 104 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#AC783F" Thickness="5" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage>
            <DrawingImage x:Key="TreeFolderOpenImage">
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource FolderTabGradient}"
                                     Geometry="M20 34 H54 L62 46 H103 C108 46 111 49 111 54 V105 H13 V45 C13 39 16 34 20 34 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#AC783F" Thickness="5" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource FolderBodyGradient}"
                                     Geometry="M30 65 H121 L104 108 C102 113 99 115 93 115 H24 C18 115 14 111 13 106 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#AC783F" Thickness="5" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FModel/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource Layer0BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AdonisForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Compact control metrics, like WPF/AdonisUI -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Menu > MenuItem">
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource Layer1HighlightBrush}" />
    </Style>
    <Style Selector="Menu > MenuItem:open /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource AdonisAccentBrush}" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Layer0BackgroundBrush}" />
        <Setter Property="MinWidth" Value="4" />
    </Style>

    <!-- AdonisUI ToolbarButton: flat, highlight on hover -->
    <Style Selector="Button.toolbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Layer3HighlightBrush}" />
    </Style>

    <!-- Status bar buttons inherit the bar color -->
    <Style Selector="Button.statusbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.statusbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- FModel's TabItemFillSpace: equal-width tabs across the left panel -->
    <Style Selector="TabControl.fill">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <c:FillTabPanel />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.fill > TabItem">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource AdonisForegroundBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.fill > TabItem:pointerover">
        <Setter Property="Background" Value="{StaticResource Layer3HighlightBrush}" />
    </Style>
    <Style Selector="TabControl.fill > TabItem:selected">
        <Setter Property="Background" Value="{StaticResource Layer1HighlightBrush}" />
    </Style>

    <!-- Asset tabs header strip (GameFilesTabControl) -->
    <Style Selector="ListBox.assettabs ListBoxItem">
        <Setter Property="Padding" Value="8,3,6,3" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="Background" Value="{StaticResource Layer3BackgroundBrush}" />
    </Style>
    <Style Selector="ListBox.assettabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Layer3HighlightBrush}" />
    </Style>
    <Style Selector="ListBox.assettabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Layer2HighlightBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AdonisForegroundBrush}" />
    </Style>
    <Style Selector="Button.tabclose">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="5.5" />
        <Setter Property="Background" Value="{StaticResource Layer3BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Layer1BorderBrush}" />
    </Style>
    <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AdonisErrorBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AdonisErrorBrush}" />
    </Style>

    <!-- INFORMATION key/value rows -->
    <Style Selector="Grid.info > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Every second cell is the caption, right-aligned like FModel's INFORMATION grids -->
    <Style Selector="Grid.info > TextBlock:nth-child(2n)">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{StaticResource AdonisDisabledForegroundBrush}" />
    </Style>
</Styles>
