<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FModel.Views.FavoriteDirectoryWindow"
        Title="Favorite Directory"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel>
        <!-- FModel's CustomDir window -->
        <StackPanel Margin="20,15,20,10" Spacing="6">
            <TextBlock Text="What is this?" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                       Text="Bored of opening folders? Save favorite directories to quickly jump to your favorite folder. They are saved for the current game directory." />
        </StackPanel>
        <Border Background="{StaticResource Layer2BackgroundBrush}" Margin="10,0,10,10" Padding="10">
            <Grid ColumnDefinitions="80,10,*" RowDefinitions="Auto,8,Auto,4,Auto">
                <TextBlock Text="Header" VerticalAlignment="Center" />
                <TextBox x:Name="HeaderBox" Grid.Column="2" Watermark="Name shown in the menu" />
                <TextBlock Grid.Row="2" Text="Directory" VerticalAlignment="Center" />
                <TextBox x:Name="PathBox" Grid.Row="2" Grid.Column="2" Watermark="Game/Content/Characters"
                         TextChanged="OnPathChanged" />
                <TextBlock x:Name="PathHint" Grid.Row="4" Grid.Column="2" FontSize="11" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Border Background="{StaticResource Layer1BackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,10,6,10" Spacing="12">
                <Button x:Name="OkButton" MinWidth="78" Content="OK" IsDefault="True" Click="OnOkClick" />
                <Button MinWidth="78" Margin="0,0,6,0" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
