<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="FModel.Views.VersioningEditorWindow"
        Title="Versioning Configuration"
        Width="720" Height="620" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Layer1BackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,10,6,10">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource AdonisErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" MinWidth="78" Content="OK" IsDefault="True" Click="OnOkClick" Margin="12,0,12,0" />
                <Button Grid.Column="2" MinWidth="78" Content="Reset" Click="OnResetClick" Margin="0,0,12,0"
                        ToolTip.Tip="Back to CUE4Parse's defaults for this UE version" />
                <Button Grid.Column="3" MinWidth="78" Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,6,0" />
            </Grid>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6" Spacing="4">
            <TextBlock Text="IF YOU DON'T KNOW WHAT THIS DOES, DON'T TOUCH IT!" FontWeight="SemiBold"
                       Foreground="{StaticResource AdonisErrorBrush}" />
            <TextBlock x:Name="HelpText" Classes="dim" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <ae:TextEditor x:Name="Editor" Margin="12,0,12,10" ShowLineNumbers="True"
                       FontFamily="Menlo, Consolas, monospace" FontSize="12"
                       Foreground="{StaticResource EditorForegroundBrush}" LineNumbersForeground="#6E7381"
                       Background="{StaticResource Layer3BackgroundBrush}"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
