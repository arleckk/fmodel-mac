<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:FModel.Views"
        x:Class="FModel.Views.SearchWindow"
        Title="Search For Packages"
        Width="1000" Height="640" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <TabControl x:Name="Tabs" Classes="fill" Margin="10" SelectionChanged="OnTabChanged">
        <TabItem Header="By Path">
            <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="8">
                <v:FileSearchPanel x:Name="PathPanel" />
            </Border>
        </TabItem>
        <TabItem x:Name="ReferencesTab" Header="References">
            <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ReferencesText" Classes="dim" Margin="0,0,0,8"
                               TextTrimming="LeadingCharacterEllipsis" />
                    <v:FileSearchPanel x:Name="ReferencesPanel" EmptyText="No references found in other packages" />
                </DockPanel>
            </Border>
        </TabItem>
    </TabControl>
</Window>
