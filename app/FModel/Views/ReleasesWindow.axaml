<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:FModel.Controls"
        xmlns:s="using:FModel.Services"
        xmlns:v="using:FModel.Views"
        x:Class="FModel.Views.ReleasesWindow"
        x:DataType="v:ReleasesWindow"
        Title="Releases"
        Width="640" Height="620" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <!-- FModel's UpdateView: download the latest release, silence the launch check, and the release history -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Layer1BackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto" Margin="30,12,6,12">
                <Button Grid.Column="1" MinWidth="78" Margin="0,0,12,0" Content="OK" IsDefault="True" IsCancel="True"
                        Click="OnOkClick" />
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="10" Spacing="10">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            <Grid ColumnDefinitions="Auto,5,Auto" HorizontalAlignment="Center">
                <Button x:Name="DownloadLatestButton" Classes="accent" VerticalAlignment="Top" Height="28"
                        Content="Download Latest Release" Click="OnDownloadLatestClick" />
                <StackPanel Grid.Column="2">
                    <SplitButton x:Name="RemindButton" Height="28" Content="Remind Me Now ..." Click="OnRemindClick">
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="In 3 Days" Tag="Days" Click="OnRemindClick" />
                                <MenuItem Header="Next Week" Tag="Week" Click="OnRemindClick" />
                                <MenuItem Header="Next Month" Tag="Month" Click="OnRemindClick" />
                                <MenuItem Header="Never" Tag="Never" Click="OnRemindClick" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <TextBlock x:Name="NextRefreshText" HorizontalAlignment="Right" FontSize="10" Margin="0,2.5,0,0" Classes="dim" />
                </StackPanel>
            </Grid>
            <c:SectionSeparator Text="HISTORY" />
        </StackPanel>

        <Panel Margin="10,0,10,10">
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                       TextWrapping="Wrap" FontWeight="SemiBold" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ReleaseList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="v:ReleaseItem">
                            <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10,8" Margin="0,0,0,5">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="{Binding Release.Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0,0,0">
                                            <Border Background="{StaticResource AdonisAccentBrush}" CornerRadius="2" Padding="5,1"
                                                    IsVisible="{Binding IsLatest}">
                                                <TextBlock Text="Latest" FontSize="10" Foreground="White" />
                                            </Border>
                                            <Border Background="{StaticResource Layer3BackgroundBrush}" CornerRadius="2" Padding="5,1"
                                                    IsVisible="{Binding IsInstalled}">
                                                <TextBlock Text="Installed" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DateText}" Classes="dim" VerticalAlignment="Center" />
                                    </Grid>
                                    <SelectableTextBlock Text="{Binding NotesText}" TextWrapping="Wrap" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="{Binding DownloadText}" IsVisible="{Binding CanDownload}" Click="OnDownloadClick" />
                                        <Button Content="View on GitHub" Click="OnViewClick" />
                                        <Button Content="Show Notes in a Tab" Click="OnShowNotesClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</Window>
