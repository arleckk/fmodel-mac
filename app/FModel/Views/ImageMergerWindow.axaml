<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:FModel.Services"
        x:Class="FModel.Views.ImageMergerWindow"
        Title="Image Merger"
        Width="1000" Height="640" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <!-- FModel's ImageMerger: the images and how they're laid out on the left, the result on the right -->
    <Grid ColumnDefinitions="*,10,*" Margin="10">
        <Border Background="{StaticResource Layer2BackgroundBrush}" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="Auto,*,40" RowDefinitions="Auto,6,Auto">
                        <TextBlock Text="Images Per Row" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="PerRowSlider" Grid.Column="1" Minimum="1" Maximum="20" TickFrequency="1"
                                IsSnapToTickEnabled="True" Value="1" ValueChanged="OnLayoutChanged" />
                        <TextBlock x:Name="PerRowText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Margin Between Images" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="MarginSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnLayoutChanged" />
                        <TextBlock x:Name="MarginText" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel>
                        <Button x:Name="AddButton" Content="Add…" MinWidth="70" Margin="0,0,6,6" Click="OnAddClick" />
                        <Button x:Name="UpButton" Content="Move Up" Margin="0,0,6,6" Click="OnUpClick" />
                        <Button x:Name="DownButton" Content="Move Down" Margin="0,0,6,6" Click="OnDownClick" />
                        <Button x:Name="RemoveButton" Content="Remove" MinWidth="70" Margin="0,0,6,6" Click="OnRemoveClick" />
                        <Button x:Name="ClearButton" Content="Clear" MinWidth="70" Margin="0,0,6,6" Click="OnClearClick" />
                    </WrapPanel>
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                               Text="Add image files, or right-click a texture preview and choose Add to Image Merger." />
                </StackPanel>
                <ListBox x:Name="ImagesList" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="s:MergeImage">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Classes="dim" FontSize="11" Margin="10,0,0,0" Text="{Binding Details}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource Layer2BackgroundBrush}" Padding="10">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
                    <TextBlock x:Name="ResultText" Classes="dim" VerticalAlignment="Center" />
                    <Button x:Name="OpenButton" Grid.Column="1" Content="Open Image" Margin="0,0,6,0" Click="OnOpenClick" />
                    <Button x:Name="SaveButton" Grid.Column="2" Content="Save Image" Classes="accent" Click="OnSaveClick" />
                </Grid>
                <Border Background="{StaticResource Layer3BackgroundBrush}">
                    <Panel>
                        <Image x:Name="Preview" Stretch="Uniform" Margin="6" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="dim"
                                   FontWeight="SemiBold" Text="No images" />
                    </Panel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
